#!/usr/bin/env bash

# Build the current Rash baseline in Nix's sandbox.
set -u

case "${1-}" in
"")
	nix build .#default
	;;
--debug)
	nix build .#debug
	;;
--zig)
	nix build .#zig
	;;
--test)
	exec "$(dirname "$0")/test"
	;;
-h|--help)
	printf '%s\n' 'usage: ./build [--debug | --zig | --test]'
	;;
*)
	printf 'unknown build option: %s\n' "$1" >&2
	exit 64
	;;
esac
