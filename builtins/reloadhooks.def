$PRODUCES reloadhooks.c

$BUILTIN reloadhooks
$FUNCTION reloadhooks_builtin
$SHORT_DOC reloadhooks
Reload the configured Rash lifecycle hooks.

The builtin is available only when Rash starts with
RASH_HOOK_RELOAD_BUILTIN=1. It rechecks hook admission and replaces the
active hook set only when every configured hook loads successfully.

Exit Status:
Returns success if the configured hook set was reloaded.
$END

#include <config.h>

#if defined (HAVE_UNISTD_H)
#  ifdef _MINIX
#    include <sys/types.h>
#  endif
#  include <unistd.h>
#endif

#include "../shell.h"
#include "../hooks.h"
#include "common.h"

int
reloadhooks_builtin (WORD_LIST *list)
{
  if (no_options (list))
    return (EX_USAGE);
  return (rash_hooks_reload ());
}
