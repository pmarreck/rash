# Download-to-shell: seam buffers producer; approve_bytes + exec_with_stdin.
# Classifier over a set; ordinary pipes must remain unaffected.

: ${THIS_SH:=../bash}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/rash-installer-approval.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' 0

contains()
{
	case $1 in
	*"$2"*)	echo yes ;;
	*)		echo no ;;
	esac
}

mkdir "$tmp/bin" || exit 1

# Local stand-ins so tests never touch the network.
cat > "$tmp/bin/curl" <<'EOF'
#!/bin/sh
# Emit a unique payload the consumer will run.
printf '%s\n' 'printf %s\\n unique-payload-42 > "$INSTALLER_MARKER"'
EOF
cat > "$tmp/bin/wget" <<'EOF'
#!/bin/sh
printf '%s\n' 'printf %s\\n unique-payload-42 > "$INSTALLER_MARKER"'
EOF
chmod +x "$tmp/bin/curl" "$tmp/bin/wget"

cp ../hooks/approve_download_pipe.lua "$tmp/approve_download_pipe.lua" || exit 1

export PATH="$tmp/bin:$PATH"
export INSTALLER_MARKER="$tmp/marker"

run_hooked()
{
	script=$1
	shift
	RASH_HOOK_DIR="$tmp" RASH_ALLOW_UNOWNED_HOOKS=1 RASH_HOOK_ENFORCE_UNOWNED=1 \
		${THIS_SH} --norc --noprofile -c "$script" "$@" 2> "$tmp/err"
	echo $?
}

# --- approve path: curl | bash runs exact buffered bytes ---
rm -f "$INSTALLER_MARKER"
status=$(RASH_APPROVE_BYTES=always run_hooked 'curl https://example.test/install.sh | bash')
err=$(cat "$tmp/err")
echo "curl|bash approve status zero: $( [ "$status" -eq 0 ] && echo yes || echo no )"
echo "curl|bash marker written: $( [ -f "$INSTALLER_MARKER" ] && echo yes || echo no )"
echo "curl|bash exact payload: $(contains "$(cat "$INSTALLER_MARKER" 2>/dev/null)" "unique-payload-42")"

# --- reject path: consumer never runs ---
rm -f "$INSTALLER_MARKER"
status=$(RASH_APPROVE_BYTES=never run_hooked 'curl https://example.test/install.sh | bash')
err=$(cat "$tmp/err")
echo "curl|bash reject denied: $(contains "$err" "download-to-shell")"
echo "curl|bash reject status nonzero: $( [ "$status" -ne 0 ] && echo yes || echo no )"
echo "curl|bash reject marker absent: $( [ -f "$INSTALLER_MARKER" ] && echo no || echo yes )"

# --- wget | sh approve ---
rm -f "$INSTALLER_MARKER"
status=$(RASH_APPROVE_BYTES=always run_hooked 'wget -qO- https://example.test/x.sh | sh')
echo "wget|sh approve marker: $( [ -f "$INSTALLER_MARKER" ] && echo yes || echo no )"

# --- absolute producer path ---
rm -f "$INSTALLER_MARKER"
status=$(RASH_APPROVE_BYTES=always run_hooked "$tmp/bin/curl https://example.test/x.sh | bash")
echo "abs-curl|bash approve marker: $( [ -f "$INSTALLER_MARKER" ] && echo yes || echo no )"

# --- must NOT intercept: ordinary pipe ---
out=$(RASH_HOOK_DIR="$tmp" RASH_ALLOW_UNOWNED_HOOKS=1 RASH_HOOK_ENFORCE_UNOWNED=1 \
	${THIS_SH} --norc --noprofile -c 'printf hello | cat' 2> "$tmp/err")
status=$?
err=$(cat "$tmp/err")
echo "echo|cat unaffected stdout: $out"
echo "echo|cat status zero: $( [ "$status" -eq 0 ] && echo yes || echo no )"
echo "echo|cat no download deny: $(contains "$err" "download-to-shell")"

# --- curl alone (no pipe to shell): no intercept ---
rm -f "$INSTALLER_MARKER"
status=$(run_hooked 'curl https://example.test/x.sh > "$INSTALLER_MARKER"')
err=$(cat "$tmp/err")
echo "curl-alone no download deny: $(contains "$err" "download-to-shell")"
echo "curl-alone status zero: $( [ "$status" -eq 0 ] && echo yes || echo no )"
