# Phase 4 waist: Lua may deny a simple command's redirects before the C
# apply port. Nil lets do_redirections run. A returned value does not apply
# a second time. Commands with no redirects skip the hook.

: ${THIS_SH:=../bash}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/rash-rack-redirect.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' 0

contains()
{
	case $1 in
	*"$2"*)	echo yes ;;
	*)		echo no ;;
	esac
}

mkdir -p "$tmp/hooks"

cat > "$tmp/hooks/redirect.lua" <<'EOF'
rash.on_redirect_policy(function(info)
  rash.audit("policy")
  local i = 1
  while info.redirects and info.redirects[i] do
    local word = info.redirects[i].word
    if word == "BLOCKED" or word == "BLOCKED2" then
      rash.deny("refusing BLOCKED")
      return
    end
    i = i + 1
  end
end)
EOF

run()
{
	RASH_AUDIT_LOG="$tmp/audit" RASH_HOOK_DIR="$tmp/hooks" \
		RASH_ALLOW_UNOWNED_HOOKS=1 RASH_HOOK_ENFORCE_UNOWNED=1 \
		${THIS_SH} --norc --noprofile -c "$1" >"$tmp/out" 2>"$tmp/err"
	echo $? >"$tmp/status"
}

: > "$tmp/audit"
run "cd '$tmp' && echo hi > BLOCKED"
echo "deny missing: $( [ ! -e "$tmp/BLOCKED" ] && echo yes || echo no )"
echo "deny status: $( [ "$(cat "$tmp/status")" != 0 ] && echo yes || echo no )"
echo "deny message: $(contains "$(cat "$tmp/err")" "refusing BLOCKED")"

: > "$tmp/audit"
run "cd '$tmp' && echo hi > OK"
echo "allow content: $( [ "$(cat "$tmp/OK" 2>/dev/null)" = "hi" ] && echo yes || echo no )"
echo "allow audited: $(contains "$(cat "$tmp/audit")" "policy")"

: > "$tmp/audit"
run 'echo plain'
echo "plain output: $( [ "$(cat "$tmp/out")" = "plain" ] && echo yes || echo no )"
case "$(cat "$tmp/audit")" in
*policy*)	echo "plain skipped policy: no" ;;
*)		echo "plain skipped policy: yes" ;;
esac

: > "$tmp/audit"
run "cd '$tmp' && enable -n echo && echo hi > CHILD"
echo "child allow: $( [ "$(cat "$tmp/CHILD" 2>/dev/null)" = "hi" ] && echo yes || echo no )"

: > "$tmp/audit"
run "cd '$tmp' && enable -n echo && echo hi > BLOCKED2"
echo "child deny missing: $( [ ! -e "$tmp/BLOCKED2" ] && echo yes || echo no )"

# fd-number rows (2>&1, 2>&-) have no word. Reading them must not crash.
cat > "$tmp/hooks/rows.lua" <<'EOF2'
rash.on_redirect_policy(function(info)
  local i = 1
  while info.redirects[i] do
    rash.audit("row" .. i .. "=" .. tostring(info.redirects[i].word))
    i = i + 1
  end
end)
EOF2
: > "$tmp/audit"
run "cd '$tmp' && echo hi > DUP 2>&1 3>&-"
echo "dup status: $(cat "$tmp/status")"
echo "dup content: $( [ "$(cat "$tmp/DUP" 2>/dev/null)" = "hi" ] && echo yes || echo no )"
echo "dup rows: $(contains "$(cat "$tmp/audit")" "row1=DUP") $(contains "$(cat "$tmp/audit")" "row2=nil") $(contains "$(cat "$tmp/audit")" "row3=nil")"
rm -f "$tmp/hooks/rows.lua"

# Slice B: safe-shape redirect words are expanded once, before policy.
# Rows gain path / exists / will_clobber. Any unsafe word keeps the whole
# list on the C port, unexpanded, so nothing expands twice or out of order.
cat > "$tmp/hooks/paths.lua" <<'EOF2'
rash.on_redirect_policy(function(info)
  local i = 1
  while info.redirects[i] do
    local r = info.redirects[i]
    rash.audit("p" .. i .. "=" .. tostring(r.path)
      .. " e=" .. tostring(r.exists) .. " c=" .. tostring(r.will_clobber))
    i = i + 1
  end
end)
EOF2
rm -f "$tmp/hooks/redirect.lua"
audit()
{
	cat "$tmp/audit"
}

: > "$tmp/audit"
printf 'old\n' > "$tmp/PRE"
run "cd '$tmp' && echo hi > PRE"
echo "literal row: $(contains "$(audit)" "p1=PRE e=true c=true")"
echo "literal content: $(cat "$tmp/PRE")"

: > "$tmp/audit"
run "f='$tmp/V'; echo hi > \$f"
echo "name row: $(contains "$(audit)" "p1=$tmp/V e=false c=false")"
echo "name content: $(cat "$tmp/V" 2>/dev/null)"

: > "$tmp/audit"
run "cd '$tmp' && f=NV; echo hi > \$f 2>&1"
echo "name+dup rows: $(contains "$(audit)" "p1=NV e=false c=false") $(contains "$(audit)" "p2=nil")"

# The parsed tree is reused by loops; each iteration must expand afresh.
: > "$tmp/audit"
run "cd '$tmp' && for i in 1 2; do f=L\$i; echo \$i > \$f; done"
echo "loop contents: $(cat "$tmp/L1" 2>/dev/null) $(cat "$tmp/L2" 2>/dev/null)"
echo "loop rows: $(contains "$(audit)" "p1=L1") $(contains "$(audit)" "p1=L2")"

# Unsafe shapes: no path, and the word expands exactly once (in the port).
: > "$tmp/audit"
run "cd '$tmp' && echo hi > \$(echo x >> COUNT; echo CS)"
echo "cmdsub row: $(contains "$(audit)" "p1=nil")"
echo "cmdsub once: $(wc -l < "$tmp/COUNT" | tr -d ' ')"
echo "cmdsub content: $(cat "$tmp/CS" 2>/dev/null)"

: > "$tmp/audit"
run "cd '$tmp' && f=Q; echo hi > \"\$f\""
echo "quoted row: $(contains "$(audit)" "p1=nil")"

: > "$tmp/audit"
run "cd '$tmp' && f=MIX; echo hi > \$f <<<x"
echo "herestring keeps list on C: $(contains "$(audit)" "p1=nil")"
echo "herestring content: $(cat "$tmp/MIX" 2>/dev/null)"

# Bash errors stay Bash errors: ambiguous and unbound fall back to C.
: > "$tmp/audit"
run "cd '$tmp' && f='a b'; echo hi > \$f"
echo "ambiguous row: $(contains "$(audit)" "p1=nil")"
echo "ambiguous message: $(contains "$(cat "$tmp/err")" "ambiguous redirect")"
echo "ambiguous status: $(cat "$tmp/status")"

: > "$tmp/audit"
run "cd '$tmp' && set -u; echo hi > \$NOPE_UNSET; echo after"
echo "unbound row: $(contains "$(audit)" "p1=nil")"
echo "unbound message: $(contains "$(cat "$tmp/err")" "unbound variable")"
echo "unbound after: $(contains "$(cat "$tmp/out")" "after")"

: > "$tmp/audit"
run "cd '$tmp' && f='G*'; echo hi > \$f"
echo "glob value row: $(contains "$(audit)" "p1=nil")"

# Differential: a failing open prints the same diagnostic with or without a
# policy hook, so pre-expansion cannot change what Bash reports.
for shape in "f=NODIR/x; echo hi > \$f" "echo hi > NODIR/y" "f=RO; echo hi > \$f"; do
	[ -e "$tmp/RO" ] || { : > "$tmp/RO"; chmod 0444 "$tmp/RO"; }
	run "cd '$tmp' && $shape"
	with_err=$(cat "$tmp/err" | grep -v WARNING); with_status=$(cat "$tmp/status")
	${THIS_SH} --norc --noprofile -c "cd '$tmp' && $shape" >/dev/null 2>"$tmp/err.c"; c_status=$?
	echo "diff [$shape]: $( [ "$with_err" = "$(cat "$tmp/err.c")" ] && [ "$with_status" = "$c_status" ] && echo same || echo "DIFFERENT: $with_err / $(cat "$tmp/err.c")" )"
done

# exec makes the redirect outlive the command; the applied copy must not.
run "cd '$tmp' && f=EX; exec 3> \$f; echo three >&3; exec 3>&-; cat EX"
echo "exec persistent: $(cat "$tmp/out")"
